---
import { clinic } from '../config/clinic';
import { brand } from '../config/brand';

const { street, city, region, postalCode } = clinic.address;
const mapQuery = encodeURIComponent(`${street}, ${city}, ${region} ${postalCode}`);
const conditions = [
  ['Back pain', '/health/back-pain'],
  ['Knee pain', '/health/knee-pain'],
  ['Neck pain', '/health/neck-pain'],
  ['Sciatica', '/health/sciatica'],
  ['Sports injuries', '/health/sports-injuries'],
  ['Muscle strains', '/health/muscle-strain'],
  ['Postural pain', '/health/poor-posture'],
  ['Movement limitations', '/health/limited-range-of-motion'],
];
---
<section class="clinic-panel" aria-labelledby="clinic-panel-title">
  <h2 id="clinic-panel-title">Robotic Precision Therapy at RPT Clinic in {city}, {region}</h2>
  <p>RPT Clinic provides assessment-led care for pain and movement problems. Robotic Precision Therapy uses the RX2600 robotic system to apply controlled, repeatable pressure to selected soft tissues, so the same technique can be delivered consistently from visit to visit. It is used within an individualized plan alongside movement, mobility, and strengthening guidance. Individual responses vary, and results are not guaranteed. <a href={clinic.landingUrl}>Learn more about Robotic Precision Therapy and how it works</a>.</p>

  <h3>Conditions we evaluate</h3>
  <ul class="panel-conditions">
    {conditions.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
  </ul>

  <h3>What to expect at your first visit</h3>
  <ol>
    <li><strong>History:</strong> when symptoms started, what changes them, and what you have already tried.</li>
    <li><strong>Movement assessment:</strong> mobility, strength, posture, and the muscles involved.</li>
    <li><strong>Safety screening:</strong> checking for signs that need a medical referral instead.</li>
    <li><strong>Plan:</strong> whether RPT is appropriate for you and what a care plan could look like.</li>
  </ol>
  <p>Coverage, referral requirements, and appointment availability vary, so please ask the clinic when you schedule.</p>

  <div class="panel-contact">
    <div>
      <p class="panel-label">Call or book</p>
      <p><a class="panel-phone" href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a></p>
      <p><a class="cta-button" href={brand.appointmentUrl}>{clinic.appointmentLabel}</a> <a class="panel-link" href={clinic.serviceUrl}>Physical therapy in Troy, Michigan</a></p>
      <p class="panel-label">Address</p>
      <address>{brand.name}<br />{street}<br />{city}, {region} {postalCode}<br /><a href={clinic.mapUrl}>Get directions</a></address>
      <p class="panel-label">Hours</p>
      <p>{clinic.hours}</p>
      <p class="panel-label">Serving patients near</p>
      <p>{clinic.serviceAreas.join(', ')}. <a href="/locations">See all participating locations</a></p>
    </div>
    <div class="panel-map"><iframe title={`Map to RPT Clinic in ${city}, ${region}`} src={`https://www.google.com/maps?output=embed&q=${mapQuery}`} loading="lazy"></iframe></div>
  </div>

  {clinic.providers.length > 0 && (
    <>
      <h3>Our clinicians</h3>
      <ul class="panel-providers">
        {clinic.providers.map((p) => <li><strong>{p.name}</strong>, {p.credentials}{p.bio ? ` — ${p.bio}` : ''}</li>)}
      </ul>
    </>
  )}
</section>

<style>
  .clinic-panel { margin: 2.5rem 0; padding: 1.75rem; border: 1px solid rgba(30, 99, 214, .25); border-radius: 16px; background: linear-gradient(120deg, #eaf3ff, #fff); }
  .clinic-panel h2 { margin-top: 0; color: var(--brand-ink); }
  .clinic-panel h3 { margin: 1.5rem 0 .5rem; color: var(--brand-ink); }
  .panel-conditions { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; }
  .panel-conditions a { display: inline-block; padding: .35rem .8rem; border: 1px solid #cbd9ea; border-radius: 999px; background: #fff; text-decoration: none; font-weight: 600; }
  .panel-contact { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem; }
  .panel-label { margin: 1rem 0 .15rem; font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--brand-primary); }
  .panel-phone { font-size: 1.5rem; font-weight: 800; }
  .cta-button { display: inline-block; padding: .6rem 1.1rem; border-radius: 6px; background: var(--brand-primary); color: #fff; font-weight: 700; text-decoration: none; }
  .panel-link { margin-left: .75rem; font-weight: 600; }
  address { font-style: normal; }
  .panel-map { min-height: 18rem; overflow: hidden; border: 1px solid #d6e1ef; border-radius: 12px; }
  .panel-map iframe { width: 100%; height: 100%; min-height: 18rem; border: 0; }
  @media (max-width: 760px) { .panel-contact { grid-template-columns: 1fr; } }
</style>
