---
import { brand } from '../config/brand';
import { clinic } from '../config/clinic';
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="container footer-grid"><div><a href="https://rptclinic.com/" aria-label="RPT Clinic home"><img src="https://rptclinic.com/wp-content/uploads/2025/07/logo.png" alt="RPT Clinic" width="220" height="80" loading="lazy" /></a><p>Robotic Precision Therapy in Troy, Michigan.</p><p><a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a><br /><a href={`mailto:${clinic.email}`}>{clinic.email}</a></p></div><div><h2>RPT Clinic</h2><ul><li><a href="https://rptclinic.com/our-team/">Our Team</a></li><li><a href="https://rptclinic.com/articles/">Articles</a></li><li><a href="https://rptclinic.com/testimonials-2/">Testimonials</a></li><li><a href="https://rptclinic.com/contact/">Contact</a></li></ul></div><div><h2>Visit Us</h2><p><a href={clinic.mapUrl}>{clinic.address.street}<br />{clinic.address.city}, {clinic.address.region} {clinic.address.postalCode}</a></p><p>{clinic.hours}</p><p><a href="https://www.facebook.com/RPTClinic">Facebook</a> · <a href="https://www.instagram.com/rptclinic/">Instagram</a> · <a href="https://www.youtube.com/@RPTclinictroy">YouTube</a></p></div></div><div class="container footer-bottom">© {year} {brand.legalName}. Health-library content is for education and is not a substitute for medical advice.</div></footer>
