---
export interface SearchArticle {
  id: string;
  title: string;
  excerpt: string;
  category: string;
  tags: string[];
  readingTime: number;
}

export interface Props {
  categories: string[];
  articles: SearchArticle[];
  compact?: boolean;
}

const { categories, articles, compact = false } = Astro.props;
---
<div class:list={['library-search', { compact }]} data-library-search>
  <label for="library-query">Search the health library</label>
  <div class="search-controls">
    <input id="library-query" type="search" placeholder="Try “back pain” or “MRI”" data-search-input autocomplete="off" />
    <select aria-label="Filter by topic" data-category-filter>
      <option value="">All topics</option>
      {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
    </select>
  </div>
  <div class="search-results" data-search-results hidden>
    <p class="search-status" data-search-status aria-live="polite"></p>
    <ul class="search-results-list">
      {articles.map((article) => (
        <li data-search-result data-category={article.category.toLowerCase()} data-search={`${article.title} ${article.excerpt} ${article.category} ${article.tags.join(' ')}`.toLowerCase()}>
          <a href={`/health/${article.id}`}>
            <span>{article.category}</span>
            <strong>{article.title}</strong>
            <small>{article.excerpt}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
<script>
  const shell = document.querySelector('[data-library-search]');
  const input = shell?.querySelector<HTMLInputElement>('[data-search-input]');
  const filter = shell?.querySelector<HTMLSelectElement>('[data-category-filter]');
  const results = shell?.querySelector<HTMLElement>('[data-search-results]');
  const cards = Array.from(shell?.querySelectorAll<HTMLElement>('[data-search-result]') || []);
  const status = shell?.querySelector<HTMLElement>('[data-search-status]');
  const searchParams = new URLSearchParams(window.location.search);
  const initialQuery = searchParams.get('q') || '';
  const initialLetter = searchParams.get('letter') || '';
  if (input && initialQuery) input.value = initialQuery;
  const runSearch = () => {
    const query = input?.value.toLowerCase().trim() || '';
    const category = filter?.value || '';
    const active = Boolean(query || category || initialLetter);
    let visible = 0;
    cards.forEach((card) => {
      const title = card.querySelector('strong')?.textContent?.trim().toUpperCase() || '';
      const show = active && (!query || (card.dataset.search || '').includes(query)) && (!category || card.dataset.category === category) && (!initialLetter || title.startsWith(initialLetter.toUpperCase()));
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (results) results.hidden = !active;
    if (status) status.textContent = active ? `${visible} article${visible === 1 ? '' : 's'} found` : '';
  };
  input?.addEventListener('input', runSearch); filter?.addEventListener('change', runSearch);
  runSearch();
</script>
<style>
  .search-results { margin-top: 1rem; background: #fff; border-radius: 0.5rem; box-shadow: 0 0.75rem 2rem rgba(20, 34, 76, 0.18); color: var(--brand-ink); overflow: hidden; text-align: left; }
  .search-status { margin: 0; padding: 0.875rem 1rem; border-bottom: 1px solid #e5e9f2; color: var(--brand-muted); font-size: 0.9rem; }
  .search-results-list { list-style: none; margin: 0; padding: 0; max-height: 25rem; overflow-y: auto; }
  .search-results-list li + li { border-top: 1px solid #e5e9f2; }
  .search-results-list a { display: grid; gap: 0.25rem; padding: 1rem; color: inherit; text-decoration: none; }
  .search-results-list a:hover { background: #f8f9fd; }
  .search-results-list span { color: var(--brand-primary); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .search-results-list strong { font-size: 1rem; }
  .search-results-list small { color: var(--brand-muted); line-height: 1.4; }
</style>
