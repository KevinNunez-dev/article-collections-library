---
import { getArticleThumbnail } from '../config/articleImages';

export interface Props { article: any; featured?: boolean }
const { article, featured = false } = Astro.props;
const { data, id } = article;
const thumbnail = getArticleThumbnail(id, data.image, data.title, data.category);
---
<article class:list={['article-card', { featured }]}>
	<a class="article-card-thumbnail" href={`/health/${id}`} tabindex="-1" aria-hidden="true">
		<img src={thumbnail} alt="" loading="lazy" onerror="this.onerror=null; this.src='/images/rpt-clinic-treatment.jpg';" />
	</a>
	<div class="article-card-content">
		<p class="eyebrow"><a href={`/topics/${data.categorySlug}`}>{data.category}</a></p>
		<h2><a href={`/health/${id}`}>{data.title}</a></h2>
		<p class="article-excerpt">{data.excerpt}</p>
		<div class="article-card-meta"><span>{data.readingTime} min read</span><span>Updated {new Date(data.updatedAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span></div>
		<a class="text-link" href={`/health/${id}`}>Read article <span aria-hidden="true">→</span></a>
	</div>
</article>

<style>
	.article-card { display: flex; flex-direction: column; overflow: hidden; }
	.article-card-thumbnail { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--brand-surface); }
	.article-card-thumbnail img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.article-card-content { min-width: 0; padding: 1.1rem; }
	.article-card-content .eyebrow { margin-top: 0; }
	.article-card-content h2 { margin-top: 0; }
	.article-excerpt { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
	@media (max-width: 560px) { .article-card-content { padding: .9rem; } .article-card-content h2 { font-size: 1.12rem; } }
</style>
