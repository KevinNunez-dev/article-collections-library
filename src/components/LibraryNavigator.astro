---
export interface NavigatorArticle {
  id: string;
  title: string;
}

export interface NavigatorCategory {
  id: string;
  title: string;
}

export interface Props {
  articles: NavigatorArticle[];
  categories: NavigatorCategory[];
}

const { articles, categories } = Astro.props;
const alphabeticalArticles = [...articles].sort((first, second) => first.title.localeCompare(second.title));
const letters = [...new Set(alphabeticalArticles.map((article) => article.title.charAt(0).toUpperCase()))];
---

<aside class="library-navigator" aria-label="Browse the health library">
  <div class="navigator-heading">
    <p class="navigator-kicker">Browse the library</p>
    <h2>Find a topic</h2>
  </div>

  <form class="navigator-search" action="/health">
    <label for="navigator-query">Search article titles</label>
    <input id="navigator-query" name="q" type="search" placeholder="Search the library" autocomplete="off" />
  </form>

  <nav class="navigator-topics" aria-label="Health topics">
    <p>Topics</p>
    <ul>
      {categories.map((category) => <li><a href={`/topics/${category.id}`}>{category.title}</a></li>)}
    </ul>
  </nav>

  <nav class="navigator-directory" aria-label="Article directory">
    <p>Article directory</p>
    <div class="navigator-results">
      {letters.map((letter) => (
        <details id={`library-letter-${letter}`}>
          <summary>{letter}<span>{alphabeticalArticles.filter((article) => article.title.startsWith(letter)).length}</span></summary>
          <ul>
            {alphabeticalArticles.filter((article) => article.title.startsWith(letter)).slice(0, 3).map((article) => (
              <li><a href={`/health/${article.id}`}>{article.title}</a></li>
            ))}
          </ul>
          <a class="navigator-more" href={`/health?letter=${letter}`}>View all {letter} articles</a>
        </details>
      ))}
    </div>
  </nav>
</aside>

<style>
  .library-navigator { position: sticky; top: 7.5rem; max-height: calc(100vh - 9rem); padding: 1.25rem; overflow-y: auto; border: 1px solid #dce2eb; border-radius: .45rem; background: #fff; }
  .navigator-heading h2 { margin: .2rem 0 1rem; font-size: 1.3rem; letter-spacing: 0; }
  .navigator-kicker, .navigator-topics > p, .navigator-directory > p { margin: 0; color: var(--brand-primary); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .navigator-search { display: grid; gap: .4rem; color: var(--brand-ink); font-size: .82rem; font-weight: 700; }
  .navigator-search input { width: 100%; padding: .65rem .7rem; border: 1px solid #b8c6dd; border-radius: .3rem; font: inherit; }
  .navigator-topics, .navigator-directory { margin-top: 1.25rem; }
  .navigator-topics ul, .navigator-directory ul { display: grid; gap: .35rem; margin: .55rem 0 0; padding: 0; list-style: none; }
  .navigator-topics a, .navigator-directory a { color: var(--brand-ink); font-size: .88rem; line-height: 1.35; text-decoration: none; }
  .navigator-topics a:hover, .navigator-directory a:hover { color: var(--brand-primary); text-decoration: underline; }
  .navigator-results { display: grid; gap: .4rem; margin-top: .55rem; }
  .navigator-results details { border: 1px solid #dce2eb; border-radius: .3rem; }
  .navigator-results summary { display: flex; align-items: center; justify-content: space-between; padding: .55rem .65rem; cursor: pointer; color: var(--brand-ink); font-size: .88rem; font-weight: 800; }
  .navigator-results summary span { color: var(--brand-muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .navigator-results details[open] summary { border-bottom: 1px solid #dce2eb; color: var(--brand-primary); }
  .navigator-results details ul { padding: 0 .65rem; }
  .navigator-more { display: inline-block; padding: .35rem .65rem .65rem; color: var(--brand-primary) !important; font-size: .82rem !important; font-weight: 800; }
  @media (max-width: 900px) { .library-navigator { position: static; max-height: none; } .navigator-results { max-height: 18rem; overflow-y: auto; padding-right: .5rem; } }
</style>
