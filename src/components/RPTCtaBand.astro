---
export interface Props {
  heading: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  variant?: 'primary' | 'secondary'; // primary = dark blue, secondary = gold accent
}

const {
  heading,
  description,
  ctaText = "Book Your Consultation",
  ctaHref = "#contact",
  variant = 'primary'
} = Astro.props;
---

<section class:list={["rpt-cta-band", `variant-${variant}`]}>
  <div class="container narrow">
    <div class="cta-content">
      <div class="cta-text">
        <h2>{heading}</h2>
        {description && <p>{description}</p>}
      </div>
      <a href={ctaHref} class="button-cta">
        {ctaText}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .rpt-cta-band {
    padding: 3.5rem 0;
  }

  .rpt-cta-band.variant-primary {
    background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-dark) 100%);
    color: #fff;
  }

  .rpt-cta-band.variant-secondary {
    background: linear-gradient(135deg, var(--brand-accent) 0%, #d99b00 100%);
    color: #fff;
  }

  .cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta-text {
    flex: 1;
  }

  .rpt-cta-band h2 {
    color: #fff;
    margin-top: 0;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .rpt-cta-band p {
    font-size: 1.05rem;
    margin: 0;
    opacity: 0.95;
    max-width: 55ch;
  }

  .button-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    color: var(--brand-primary);
    font-weight: 700;
    padding: 1rem 1.75rem;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    font-size: 1rem;
  }

  .rpt-cta-band.variant-primary .button-cta {
    color: var(--brand-primary);
  }

  .rpt-cta-band.variant-secondary .button-cta {
    color: var(--brand-accent);
  }

  .button-cta:hover {
    background: #f0f0f0;
    transform: translateX(4px);
  }

  /* Light background variant styling */
  .rpt-cta-band.variant-secondary .button-cta {
    background: rgba(255, 255, 255, 0.95);
  }

  .rpt-cta-band.variant-secondary .button-cta:hover {
    background: #fff;
  }

  @media (max-width: 768px) {
    .rpt-cta-band {
      padding: 2.5rem 0;
    }

    .cta-content {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }

    .button-cta {
      width: 100%;
      justify-content: center;
    }

    .rpt-cta-band p {
      max-width: 100%;
    }
  }
</style>
