---
export interface Props { items: Array<{ label: string; href?: string }> }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{items.map((item, index) => <li>{item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
