---
import { brand } from '../config/brand';
import { getAllCategories } from '../lib/content';
const pathname = Astro.url.pathname;
const categories = (await getAllCategories()).filter((c) => !c.data?.seo?.noindex).sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
---
<header class="site-header">
	<div class="container header-row">
		<a class="brand" href="/" aria-label="Home"><img src={brand.logoUrl} alt={brand.logoAlt} width="160" height="40" /></a>
		<link rel="stylesheet" href="/styles/header.css" />
		<nav aria-label="Primary navigation">
			<ul class="nav-list">
				{brand.headerNav.map((item) => <li><a class:list={[{ active: pathname.startsWith(item.href) && item.href !== '/' }]} href={item.href}>{item.label}</a></li>)}

				<li class="nav-dropdown">
						<button class="nav-link" aria-haspopup="true" aria-expanded="false">Topics</button>
						<ul class="nav-dropdown-menu">
							{categories.map((cat) => <li><a href={`/topics/${cat.id}`}>{cat.data.title}</a></li>)}
						</ul>
					</li>
			</ul>
		</nav>
		<a class="button button-small" href={brand.appointmentUrl}>Make an appointment</a>
	</div>
</header>
<script src="/scripts/header-dropdown.js" defer></script>
