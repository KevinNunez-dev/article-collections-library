---
import { brand } from '../config/brand';
const pathname = Astro.url.pathname;
---
<header class="site-header"><div class="container header-row"><a class="brand" href="/" aria-label={`${brand.name} home`}><img src={brand.logoUrl} alt={brand.logoAlt} width="160" height="40" /></a><nav aria-label="Primary navigation"><ul class="nav-list">{brand.headerNav.map((item) => <li><a class:list={[{ active: pathname.startsWith(item.href) && item.href !== '/' }]} href={item.href}>{item.label}</a></li>)}</ul></nav><a class="button button-small" href={brand.appointmentUrl}>Make an appointment</a></div></header>
