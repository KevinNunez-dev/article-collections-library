---
export interface Props { items: Array<{ question: string; answer: string }> }
const { items } = Astro.props;
---
{items.length > 0 && <section class="faq" aria-labelledby="faq-title"><h2 id="faq-title">Frequently asked questions</h2>{items.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
