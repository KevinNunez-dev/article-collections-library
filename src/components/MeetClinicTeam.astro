---
const team = [
  { name: 'Dr. Lauren Michon', credentials: 'DPT, PT, CIDN, RPT', image: '/health/landing-assets/img/headshot-lauren.png' },
  { name: 'Dr. Becca Wilner', credentials: 'DPT, RPT', image: '/health/landing-assets/img/dr-becca.jpg' },
  { name: 'Ben Blankenship', credentials: 'CNMT, RPT', image: '/health/landing-assets/img/headshot-blankenship.png' },
];
---

<section class="meet-clinic-team" aria-labelledby="team-heading">
  <div class="team-header">
    <div>
      <p class="eyebrow">RPT Clinic · Troy, Michigan</p>
      <h2 id="team-heading">Meet part of the care team</h2>
      <p>Get to know the people behind RPT Clinic's assessment-led approach.</p>
    </div>
    <a href="https://rptclinic.com/our-team/">Meet the full team <span aria-hidden="true">→</span></a>
  </div>
  <div class="team-grid">
    {team.map((member) => (
      <div class="team-card">
        <img src={member.image} alt={member.name} width="160" height="160" loading="lazy" />
        <div>
          <h3>{member.name}</h3>
          <p>{member.credentials}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .meet-clinic-team { margin: 3rem 0; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid #d6e4f4; border-radius: 1rem; background: #f5f9ff; }
  .team-header { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.5rem; }
  h2 { margin: .25rem 0 .5rem; }
  .team-header p:not(.eyebrow) { margin: 0; color: var(--brand-muted); }
  .team-header a { flex-shrink: 0; font-weight: 700; }
  .team-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .team-card { display: flex; align-items: center; gap: 1rem; padding: 1rem; border: 1px solid #e0e9f3; border-radius: .75rem; background: #fff; }
  .team-card img { flex: none; width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; object-position: center top; }
  .team-card h3 { margin: 0; font-size: 1rem; font-weight: 700; letter-spacing: 0; }
  .team-card p { margin: .25rem 0 0; color: var(--brand-muted); font-size: .85rem; }
  @media (max-width: 900px) { .team-grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .team-header { align-items: flex-start; flex-direction: column; } }
</style>
