---
interface VideoTab {
  id: string;
  label: string;
  videoSrc: string;
  videoType: 'vimeo' | 'mp4';
  posterSrc: string;
  description: string;
}

interface Props {
  headline: string;
  summary: string;
  cta: string;
  ctaurl: string;
  ctabuttonclass: string;
  ctabuttonclassMobile: string;
}

const props = Astro.props;

// Define video tabs for different ailments
const videoTabs: VideoTab[] = [
  {
    id: "how it works",
    label: "How It Works",
    videoSrc: "https://player.vimeo.com/video/1156254116",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "Watch how RPT targets the muscles to provide lasting relief."
  },
  {
    id: "back_pain",
    label: "Back Pain",
    videoSrc: "https://player.vimeo.com/video/1098293206",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "See how we address chronic lower back pain with robotic precision therapy."
  },
  {
    id: "carpal_tunnel",
    label: "Carpal Tunnel",
    videoSrc: "https://player.vimeo.com/video/1129941541",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "Discover our approach to relieving stubborn carpal tunnel pain and wrist tension."
  },
  {
    id: "knee_pain",
    label: "Knee Pain",
    videoSrc: "https://player.vimeo.com/video/1094124482",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "Learn how RPT restores mobility and reduces knee pain without surgery."
  },
  {
    id: "shoulder_pain",
    label: "Shoulder Pain",
    videoSrc: "https://player.vimeo.com/video/1129941541",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "Watch how we treat shoulder pain with targeted robotic precision."
  },
  {
    id: "hip_pain",
    label: "Hip Pain",
    videoSrc: "https://player.vimeo.com/video/1129021912",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "See how RPT addresses hip pain at its source for lasting relief."
  },
  {
    id: "testimonials",
    label: "Testimonials",
    videoSrc: "https://player.vimeo.com/video/1065589415",
    videoType: "vimeo",
    posterSrc: "/health/landing-assets/img/mastheadGradient1-bg.png",
    description: "Watch how RPT has helped patients achieve lasting relief."
  }
];
---

<div id="treatment" class="bg-gradient-to-b from-[#071633] via-[#0b2a40] to-[#071633] text-brand-secondary py-10 overflow-hidden">
  <div class="container mx-auto max-w-6xl">
    <p class="section-headline mt-10 mb-6 text-center">Relief When Nothing Else Works</p>

    <!-- Tab Navigation -->
    <div class="mb-8 overflow-hidden scrollbar-hide px-4">
      <div class="flex gap-2 border-b-2 border-white/20 min-w-max justify-center">
        {videoTabs.map((tab, index) => (
          <button
            data-video-tab-btn
            data-tab-id={tab.id}
            class={`
              px-4 md:px-6 py-3 font-bold text-sm md:text-base transition-all duration-300 whitespace-nowrap relative
              ${index === 0 
                ? 'text-white border-b-4 border-cyan-400' 
                : 'text-gray-300 hover:text-white hover:bg-white/5 border-b-4 border-transparent hover:border-cyan-400/50'
              }
            `}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Video Tab Content -->
    <div class="relative px-4 overflow-hidden">
      {videoTabs.map((tab, index) => (
        <div
          data-video-tab-content
          data-tab-id={tab.id}
          class={`video-tab-panel ${index === 0 ? 'active' : 'hidden'}`}
        >
          <div class="max-w-3xl mx-auto mb-6">
            {tab.videoType === 'vimeo' ? (
              // Vimeo iframe embed
              <div class="relative rounded-xl overflow-hidden shadow-2xl bg-black aspect-[16/9]">
                <iframe 
                  src={tab.videoSrc}
                  title={`${tab.label} treatment video`}
                  class="w-full h-full absolute inset-0 overflow-hidden"
                  allowfullscreen
                  loading="lazy"
                  scrolling="no"
                ></iframe>
              </div>
            ) : (
              // MP4 video with custom play button
              <div class="relative rounded-xl overflow-hidden shadow-2xl bg-black aspect-[16/9]">
                <button
                  data-video-play-btn
                  data-video-id={`treatment-video-${tab.id}`}
                  type="button"
                  aria-label={`Play ${tab.label} video`}
                  class="group absolute inset-0 w-full h-full z-10 flex items-center justify-center transition bg-black/60 hover:bg-black/40"
                >
                  <img 
                    src={tab.posterSrc}
                    class="object-cover w-full h-full absolute inset-0 group-hover:scale-105 transition duration-300" 
                    style="z-index: 1;"
                    alt={`${tab.label} treatment preview`}
                  />
                  <span class="relative z-20 flex items-center justify-center drop-shadow-lg group-hover:scale-110 transition duration-300">
                    <svg width="68" height="68" viewBox="0 0 68 68" fill="none">
                      <circle cx="34" cy="34" r="34" fill="rgba(0,0,0,0.5)" />
                      <circle cx="34" cy="34" r="32" stroke="rgba(255,255,255,0.3)" stroke-width="2" fill="none" class="group-hover:stroke-cyan-400 transition duration-300" />
                      <polygon points="28,21 28,47 50,34" fill="#fff" />
                    </svg>
                  </span>
                </button>
                <video 
                  data-treatment-video
                  id={`treatment-video-${tab.id}`}
                  class="w-full h-full object-cover"
                  controls
                  preload="metadata"
                  playsinline
                  style="display: none;"
                  poster={tab.posterSrc}
                >
                  <source src={tab.videoSrc} type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
              </div>
            )}
            
            <!-- Video Description -->
            <p class="text-center text-gray-200 mt-4 text-sm md:text-base px-2">
              {tab.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Content -->
    <div class="mt-10 px-4 max-w-3xl mx-auto">
      <p class="mb-4 text-gray-200 leading-relaxed">
        <strong class="text-white">Tried everything and still in pain?</strong> Many of our patients come to us after exhausting options like injections, medications, massage, or even surgery.
      </p>
      <p class="mb-10 text-gray-200 leading-relaxed">
        Most patients feel relief within their first few sessions — no drugs, no injections, no surgery. Our <strong class="text-white">RX2600 Therapeutic Robot</strong> gently lengthens tight muscles and restores mobility with pinpoint precision that hands alone can't replicate.
      </p>
    </div>
  </div>
</div>

<!-- Tab Switching and Video Player Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('[data-video-tab-btn]');
    const tabContents = document.querySelectorAll('[data-video-tab-content]');
    const playButtons = document.querySelectorAll('[data-video-play-btn]');

    // Tab switching functionality
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab-id');

        // Pause all videos when switching tabs
        document.querySelectorAll('[data-treatment-video]').forEach(video => {
          if (!video.paused) {
            video.pause();
            video.currentTime = 0;
          }
          video.style.display = 'none';
        });

        // Reset all play buttons
        document.querySelectorAll('[data-video-play-btn]').forEach(btn => {
          btn.style.display = 'block';
        });

        // Update button states with smooth transition
        tabButtons.forEach(btn => {
          const isActive = btn.getAttribute('data-tab-id') === tabId;
          
          if (isActive) {
            btn.classList.remove('text-gray-300', 'border-transparent');
            btn.classList.add('text-white', 'border-cyan-400');
          } else {
            btn.classList.remove('text-white', 'border-cyan-400');
            btn.classList.add('text-gray-300', 'border-transparent');
          }
        });

        // Fade out current content
        const activeContent = document.querySelector('[data-video-tab-content].active');
        if (activeContent) {
          activeContent.classList.add('fade-out');
          
          setTimeout(() => {
            activeContent.classList.remove('active', 'fade-out');
            activeContent.classList.add('hidden');

            // Show new content with fade in
            tabContents.forEach(content => {
              if (content.getAttribute('data-tab-id') === tabId) {
                content.classList.remove('hidden');
                content.classList.add('active', 'fade-in');

                // Remove fade-in class after animation
                setTimeout(() => {
                  content.classList.remove('fade-in');
                }, 300);
              }
            });
          }, 200);
        }
      });
    });

    // Video play button functionality (for MP4 videos)
    playButtons.forEach(playBtn => {
      playBtn.addEventListener('click', () => {
        const videoId = playBtn.getAttribute('data-video-id');
        const video = document.getElementById(videoId);
        
        if (video) {
          playBtn.style.display = 'none';
          video.style.display = 'block';
          video.play();
        }
      });
    });

    // Handle video pause/end to show play button again
    document.querySelectorAll('[data-treatment-video]').forEach(video => {
      video.addEventListener('pause', () => {
        if (video.currentTime === 0 || video.ended) {
          const videoId = video.id;
          const playBtn = document.querySelector(`[data-video-id="${videoId}"]`);
          if (playBtn) {
            playBtn.style.display = 'block';
            video.style.display = 'none';
          }
        }
      });

      video.addEventListener('ended', () => {
        const videoId = video.id;
        const playBtn = document.querySelector(`[data-video-id="${videoId}"]`);
        if (playBtn) {
          playBtn.style.display = 'block';
          video.style.display = 'none';
        }
      });
    });
  });
</script>
