---
import { addBrandLinks, addContextualTopicLinks, getAllArticles } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import Faq from '../../components/Faq.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import AppointmentCta from '../../components/AppointmentCta.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleNextStepGuide from '../../components/ArticleNextStepGuide.astro';
import JsonLd from '../../components/JsonLd.astro';
import RPTHero from '../../components/RPTHero.astro';
import RPTTestimonials from '../../components/RPTTestimonials.astro';
import RPTComparisonTable from '../../components/RPTComparisonTable.astro';
import RPTCtaBand from '../../components/RPTCtaBand.astro';
import LocalServiceAreas from '../../components/LocalServiceAreas.astro';
import { brand } from '../../config/brand';
import { clinic } from '../../config/clinic';
import { getPillar } from '../../config/pillars';
import ArticleClinicPanel from '../../components/ArticleClinicPanel.astro';
import CostTimeCalculator from '../../components/CostTimeCalculator.astro';
export async function getStaticPaths() { const articles = (await getAllArticles({ includeDrafts: import.meta.env.DEV })).filter((a) => !a.data?.seo?.noindex || (import.meta.env.DEV && a.data?.draft)); return articles.map((article) => ({ params: { slug: article.id }, props: { article } })); }
const { article } = Astro.props;
const publishedArticles = (await getAllArticles()).filter((entry) => !entry.data?.seo?.noindex && !entry.data?.draft);
const allArticles = publishedArticles.filter((entry) => entry.id !== article.id);
const articlePosition = publishedArticles.findIndex((entry) => entry.id === article.id);
const heroImage = articlePosition % 2 === 0 ? '/health/images/rpt-clinic-treatment.jpg' : '/health/images/rpt-clinic-treatment-2.jpg';
const socialImage = heroImage.replace('/health/images/', '/health/social/');
const explicitRelatedIds = article.data.related || [];
const articleTags = new Set((article.data.tags || []).map((tag: string) => tag.toLowerCase()));
const articleBodySystems = new Set(article.data.bodySystems || []);
const relatedEntries = allArticles
  .map((entry) => {
    const explicitIndex = explicitRelatedIds.indexOf(entry.id);
    const sharedTags = (entry.data.tags || []).filter((tag: string) => articleTags.has(tag.toLowerCase())).length;
    const sharedBodySystems = (entry.data.bodySystems || []).filter((system: string) => articleBodySystems.has(system)).length;
    const sameCategory = entry.data.categorySlug === article.data.categorySlug ? 1 : 0;
    const score = explicitIndex >= 0 ? 1_000 - explicitIndex : (sharedTags * 3) + sharedBodySystems + sameCategory;
    return { entry, score };
  })
  .filter(({ score }) => score > 1)
  .sort((first, second) => second.score - first.score)
  .slice(0, 3)
  .map(({ entry }) => entry);
const articleHtml = addBrandLinks(addContextualTopicLinks(article.html, article.id));
const pageUrl = new URL(`/health/${article.id}`, Astro.site).toString();
const reviewer = article.data.reviewedBy;
const pillar = getPillar(article.id, article.data.tags);
const clinicSchema = { '@context': 'https://schema.org', '@type': ['MedicalBusiness', 'LocalBusiness'], '@id': `${new URL('/', Astro.site).toString()}#clinic`, name: brand.legalName, url: 'https://rptclinic.com/', logo: brand.logoUrl, telephone: clinic.phone, email: clinic.email, hasMap: clinic.mapUrl, address: { '@type': 'PostalAddress', streetAddress: clinic.address.street, addressLocality: clinic.address.city, addressRegion: clinic.address.region, postalCode: clinic.address.postalCode, addressCountry: clinic.address.country }, areaServed: clinic.serviceAreas.map((name: string) => ({ '@type': 'City', name })), medicalSpecialty: 'PhysicalTherapy' };
const articleSchema = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: article.data.title, description: article.data.description, url: pageUrl, image: new URL(socialImage, Astro.site).toString(), datePublished: new Date(article.data.publishedAt).toISOString(), dateModified: new Date(article.data.updatedAt).toISOString(), author: { '@type': 'Organization', name: article.data.author }, publisher: { '@id': clinicSchema['@id'] }, about: { '@type': 'MedicalCondition', name: article.data.title }, ...(reviewer ? { reviewedBy: { '@type': 'Person', name: reviewer.name, jobTitle: reviewer.credentials, ...(reviewer.url ? { url: reviewer.url } : {}) }, lastReviewed: new Date(reviewer.reviewedAt).toISOString() } : {}) };
const faqSchema = (article.data.faq || []).length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: article.data.faq.map((item: any) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) } : null;
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: 'Health Library', item: new URL('/health', Astro.site).toString() }, { '@type': 'ListItem', position: 3, name: article.data.title, item: pageUrl }] };
---
<BaseLayout title={article.data.seo?.title || article.data.title} description={article.data.seo?.description || article.data.description} image={socialImage} imageAlt={`${article.data.title}: RPT Clinic clinician assessing a patient on the RX2600 Robotic Precision Therapy system`} noindex={article.data.seo?.noindex} canonical={article.data.seo?.canonical} publishedTime={article.data.publishedAt} modifiedTime={article.data.updatedAt}>
  <JsonLd data={[articleSchema, clinicSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]} />
  
  <!-- Hero Section -->
  <RPTHero
    badge={article.data.category}
    title={article.data.title}
    description={article.data.description}
    ctaText="Explore Robotic Precision Therapy"
    ctaHref={clinic.landingUrl}
    image={heroImage}
    imageAlt={`${article.data.title}: RPT Clinic clinician assessing a patient on the RX2600 Robotic Precision Therapy system`}
  />
  
  <article class="article-page">
    <div class="container article-wide">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Health Library', href: '/health' },
          { label: article.data.category, href: `/topics/${article.data.categorySlug}` },
          { label: article.data.title }
        ]}
      />
      <p class="byline">Written by {article.data.author} · Updated {new Date(article.data.updatedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })} · {article.data.readingTime} min read{reviewer && <> · Medically reviewed by {reviewer.url ? <a href={reviewer.url}>{reviewer.name}</a> : reviewer.name}, {reviewer.credentials} on {new Date(reviewer.reviewedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</>} · <a href="/medical-review-policy">Review policy</a></p>
      {pillar && <p class="pillar-link">Part of our guide to <a href={`/health/${pillar.id}`}>{pillar.label}</a>. Explore the full overview for causes, symptoms, and care options.</p>}
      <LocalServiceAreas />
      <KeyTakeaways items={article.data.keyTakeaways} />
      <ArticleNextStepGuide articleTitle={article.data.title} />
      <div class="prose">
        <div set:html={articleHtml} />
      </div>
      {article.data.costCalculator && <CostTimeCalculator />}
      <Faq items={article.data.faq} />
      <ArticleClinicPanel />
      <HealthDisclaimer />
    </div>
  </article>

  <!-- Testimonials Section -->
  {article.data.testimonials && article.data.testimonials.length > 0 && (
    <RPTTestimonials
      testimonials={article.data.testimonials}
      heading="What Our Patients Say"
      subtitle="Real results from real patients treated for this condition"
    />
  )}

  <!-- Comparison Table Section -->
  {article.data.comparison && article.data.comparison.length > 0 && (
    <section class="section">
      <div class="container">
        <RPTComparisonTable
          rows={article.data.comparison}
          heading="How Robotic Precision Therapy Compares"
          subtitle="See why patients choose RPT over traditional treatment"
          traditionalLabel="Traditional Treatment"
          rptLabel="Robotic Precision Therapy"
        />
      </div>
    </section>
  )}

  <div class="container">
    <AppointmentCta heading="Have questions about your symptoms or care?" />
  </div>

  {relatedEntries.length > 0 && (
    <section class="section section-muted">
      <div class="container">
        <h2>Related health articles</h2>
        <div class="article-grid">
          {relatedEntries.map((entry) => <ArticleCard article={entry} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Call-to-Action Band -->
  <RPTCtaBand
    heading="Ready to Start Your Recovery?"
    description="Schedule an assessment to see whether Robotic Precision Therapy is appropriate for your symptoms. Individual results vary."
    ctaText="Learn How RPT Works"
    ctaHref={clinic.landingUrl}
    variant="primary"
  />
</BaseLayout>
