---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GoogleReviewCarousel from '../../components/GoogleReviewCarousel.astro';
import MediaProof from '../../components/MediaProof.astro';
import MeetClinicTeam from '../../components/MeetClinicTeam.astro';
import { locations } from '../../config/locations';
import { brand } from '../../config/brand';

export function getStaticPaths() {
  return locations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

const { location } = Astro.props;
const mapQuery = encodeURIComponent(`${location.address}, ${location.city}, ${location.region} ${location.postalCode}`);
const isRptClinic = location.slug === 'rpt-clinic-troy-mi';
---
<BaseLayout title={`${location.name} | RX2600 Therapy`} description={`Location details and directions for ${location.name} in ${location.city}, ${location.region}.`}>
  <section class="location-hero">
    <div class="container location-hero-content">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Locations', href: '/locations' }, { label: location.name }]} />
      <p class="eyebrow">{location.city}, {location.region} · RX2600 therapy location</p>
      <h1>{location.name}</h1>
      <p class="lead">Explore location details and contact this clinic directly to learn about assessment-led care and appointment availability.</p>
      <div class="hero-actions">
        <a class="button" href={location.mapUrl}>Get directions <span aria-hidden="true">→</span></a>
        {location.phone && <a class="hero-call" href={`tel:${location.phoneHref}`}>Call {location.phone}</a>}
      </div>
    </div>
  </section>
  {isRptClinic && <MediaProof />}
  <section class="section">
    <div class="container location-detail-grid">
      <div class="location-details">
        <p class="eyebrow">Plan your visit</p>
        <h2>Find us in {location.city}</h2>
        <p class="label">Address</p>
        <address>{location.address}<br />{location.city}, {location.region} {location.postalCode}</address>
        <div class="detail-actions">
          <a class="button" href={location.mapUrl}>Get directions</a>
          {location.phone && <a class="button button-outline" href={`tel:${location.phoneHref}`}>Call {location.phone}</a>}
          {location.website && <a class="text-link" href={location.website}>Visit clinic website</a>}
        </div>
        <h2>Care at this location</h2>
        <p>Contact {location.name} to ask about its assessment process, services, costs, and whether RX2600 therapy may be appropriate for your needs.</p>
        <p>Each participating location has its own care team and appointment process. Treatment plans and individual responses vary.</p>
        {isRptClinic && <a class="text-link" href={brand.appointmentUrl}>Request an appointment with RPT Clinic →</a>}
      </div>
      <div class="location-map"><iframe title={`Map for ${location.name}`} src={`https://www.google.com/maps?output=embed&q=${mapQuery}`} loading="lazy"></iframe></div>
    </div>
  </section>
  {isRptClinic && <GoogleReviewCarousel />}
  {isRptClinic && <div class="container"><MeetClinicTeam /></div>}
  <section class="location-next">
    <div class="container location-next-content">
      <div>
        <p class="eyebrow">Keep exploring</p>
        <h2>Find information for your next step</h2>
        <p>Browse practical health guides or compare other participating locations.</p>
      </div>
      <div class="next-links">
        <a class="button" href="/health/">Explore the health library</a>
        <a class="text-link" href="/locations/">View all locations →</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .location-hero { padding: 3.5rem 0 4rem; background: radial-gradient(circle at 85% 20%, #3479b7, transparent 35%), linear-gradient(120deg, #102d54, #173f72); color: #fff; }
  .location-hero :global(.breadcrumbs a), .location-hero :global(.breadcrumbs ol), .location-hero :global(.breadcrumbs li + li::before) { color: #dceaff; }
  .location-hero .eyebrow, .location-hero h1, .location-hero .lead { color: #fff; }
  .location-hero h1 { margin-bottom: .75rem; max-width: 22ch; font-size: clamp(2.4rem, 5vw, 4.5rem); }
  .location-hero .lead { max-width: 55ch; color: #e6f0ff; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.5rem; }
  .hero-actions .button { background: #fff; color: var(--brand-primary-dark); }
  .hero-call { color: #fff; font-weight: 700; }
  .hero-call:hover { color: #dceaff; }
  .location-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: stretch; }
  .location-details { padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid #dce2eb; border-radius: 1rem; background: #fff; box-shadow: 0 14px 35px rgba(28,62,105,.06); }
  .location-details h2 { margin: .4rem 0 1rem; }
  .label { margin: 0 0 .35rem; color: var(--brand-primary); font-size: .8rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  address { color: var(--brand-ink); font-size: 1.15rem; font-style: normal; line-height: 1.6; }
  .detail-actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; margin: 1.5rem 0 2rem; }
  .button-outline { background: #fff; color: var(--brand-primary); border: 1px solid var(--brand-primary); }
  .location-map { min-height: 30rem; overflow: hidden; border: 1px solid #dce2eb; border-radius: 1rem; background: #eaf3ff; }
  .location-map iframe { width: 100%; height: 100%; min-height: 30rem; border: 0; }
  .location-next { padding: 3rem 0; background: #eaf3ff; }
  .location-next-content { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
  .location-next h2 { margin: .35rem 0; }
  .location-next p { color: var(--brand-muted); }
  .next-links { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  @media (max-width: 760px) { .location-hero { padding: 3rem 0 2.5rem; } .location-detail-grid { grid-template-columns: 1fr; } .location-map, .location-map iframe { height: 22rem; min-height: 22rem; } .location-next-content { align-items: flex-start; flex-direction: column; } }
</style>
