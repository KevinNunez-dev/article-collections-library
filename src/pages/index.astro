---
import { getAllArticles, getAllCategories } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LibrarySearch from '../components/LibrarySearch.astro';
import AppointmentCta from '../components/AppointmentCta.astro';
import { brand } from '../config/brand';
const articles = (await getAllArticles()).filter((a) => !a.data?.seo?.noindex).sort((a, b) => new Date(b.data.updatedAt).valueOf() - new Date(a.data.updatedAt).valueOf());
const categories = (await getAllCategories()).filter((c) => !c.data?.seo?.noindex).sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
---
<BaseLayout title="Health Library" description={`Explore easy-to-understand health articles, symptoms, treatments, tests and wellness guidance from ${brand.name}.`}><section class="hero"><div class="container narrow"><p class="eyebrow">{brand.name} Health Library</p><h1>Health information made easier to understand.</h1><p class="lead">Find practical answers about conditions, symptoms, tests, treatments and everyday wellness. Every article is clearly dated and medically reviewed.</p><LibrarySearch categories={categories.map((category) => category.data.title)} compact /></div></section><section class="section container"><div class="section-heading"><div><p class="eyebrow">Browse by topic</p><h2>Explore the health library</h2></div><a class="text-link" href="/health">View all articles →</a></div><div class="category-grid">{categories.map((category) => <a class="category-card" href={`/topics/${category.id}`}><span aria-hidden="true">{category.data.icon}</span><h3>{category.data.title}</h3><p>{category.data.description}</p></a>)}</div></section><section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Latest guidance</p><h2>Featured health articles</h2></div></div><div class="article-grid">{articles.slice(0,3).map((article) => <ArticleCard article={article} featured />)}</div></div></section><div class="container"><AppointmentCta /></div></BaseLayout>
