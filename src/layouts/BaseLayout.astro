---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { brand } from '../config/brand';
import { clinic } from '../config/clinic';
export interface Props { title?: string; description?: string; image?: string; noindex?: boolean; canonical?: string; publishedTime?: string | Date; modifiedTime?: string | Date }
const { title, description = brand.tagline, image, noindex = false, canonical, publishedTime, modifiedTime } = Astro.props;
const pageTitle = title ? `${title} | ${brand.name}` : `${brand.name} Health Library`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const organizationSchema = { '@context': 'https://schema.org', '@type': 'MedicalClinic', '@id': 'https://rptclinic.com/#organization', name: brand.legalName, url: 'https://rptclinic.com/', logo: 'https://rptclinic.com/wp-content/uploads/2025/07/logo.png', telephone: clinic.phone, email: clinic.email, address: { '@type': 'PostalAddress', streetAddress: clinic.address.street, addressLocality: clinic.address.city, addressRegion: clinic.address.region, postalCode: clinic.address.postalCode, addressCountry: clinic.address.country }, sameAs: ['https://www.facebook.com/RPTClinic', 'https://www.instagram.com/rptclinic/', 'https://www.youtube.com/@RPTclinictroy'] };
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${new URL('/', Astro.site)}#website`, url: new URL('/', Astro.site).toString(), name: `${brand.name} Health Library`, publisher: { '@id': 'https://rptclinic.com/#organization' }, potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${new URL('/health?q={search_term_string}', Astro.site)}` }, 'query-input': 'required name=search_term_string' } };
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="icon" href={brand.faviconUrl} /><title>{pageTitle}</title><meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} />{publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}{modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}{noindex && <meta name="robots" content="noindex,nofollow" />}<meta property="og:type" content="website" /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} />{image && <meta property="og:image" content={image} />}<meta name="twitter:card" content="summary_large_image" /><JsonLd data={[organizationSchema, websiteSchema]} /></head><body style={`--brand-primary:${brand.primaryColor};--brand-primary-dark:${brand.primaryDarkColor};--brand-accent:${brand.accentColor};--brand-ink:${brand.inkColor};--brand-muted:${brand.mutedColor};--brand-surface:${brand.surfaceColor};`}><Header /><main><slot /></main><Footer /></body></html>
